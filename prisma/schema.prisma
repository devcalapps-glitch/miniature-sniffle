
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DEV
  TESTER
}

enum ProjectStatus {
  MATCHING
  TESTING
  COMPLETED
  PAID
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  image         String?
  role          UserRole? 
  projects      Project[] @relation("DevProjects")
  applications  Application[]
  bugReports    BugReport[]
  createdAt     DateTime  @default(now())
}

model Project {
  id            String    @id @default(cuid())
  title         String
  description   String
  budget        Float
  status        ProjectStatus @default(MATCHING)
  devId         String
  dev           User      @relation("DevProjects", fields: [devId], references: [id])
  applications  Application[]
  bugReports    BugReport[]
  createdAt     DateTime  @default(now())
}

model Application {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id])
  testerId      String
  tester        User      @relation(fields: [testerId], references: [id])
  status        String    @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt     DateTime  @default(now())
}

model BugReport {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id])
  testerId      String
  tester        User      @relation(fields: [testerId], references: [id])
  title         String
  description   String
  severity      String    // CRITICAL, MAJOR, MINOR
  status        String    @default("OPEN") // OPEN, FIXED, CLOSED
  createdAt     DateTime  @default(now())
}
